# AI-reference only — specs and plans must never be committed
docs/superpowers/
.superpowers/

# Node
node_modules/
dist/
dist-ssr/
*.local

# Rust / Tauri
src-tauri/target/
# Cargo.lock is committed deliberately — this is an application, not a
# library, and lockfiles should be reproducible across machines.

# Generated by Tauri (capability/ACL schemas, editor-autocomplete only)
src-tauri/gen/

# Env
.env
.env.local

# Git worktrees (isolated workspaces for agentic implementation work)
.worktrees/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Local data (per-machine SQLite db, addon-side character data)
*.db
*.sqlite
*.sqlite3

# Scraper's local response cache (tools/scraper/out/*.json IS committed — see
# tools/scraper/config.ts and the design spec §7)
tools/scraper/.cache/
